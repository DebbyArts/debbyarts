# Database
# Pooled runtime connection used by the server-side Prisma client.
DATABASE_URL=

# Optional for local development because Prisma falls back to DATABASE_URL.
# Use a direct or session-pooled connection for hosted Prisma migrations.
DIRECT_URL=

# Supabase Auth and public Storage
# Public project URL used by browser-safe Auth clients and public object URLs.
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe Supabase publishable key. Do not use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key used solely for owner-authorized Storage
# mutations. Never prefix this variable with NEXT_PUBLIC_ or expose it to the
# browser. A legacy service-role key may be supplied where secret keys are not
# available yet.
SUPABASE_SECRET_KEY=

# Admin authorization
# Server-only normalized email for the sole provisioned Admin Auth user.
SUPABASE_ADMIN_EMAIL=

# App URL and production
# No application URL variable is read. Configure the local, preview (if used),
# and production /auth/confirm URLs in Supabase Auth Redirect URLs.
