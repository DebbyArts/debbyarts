# Supabase transaction-pooler URI used by the deployed application and seed.
DATABASE_URL=

# Supabase direct URI, or session-pooler URI when the migration runner is IPv4-only.
DIRECT_URL=

# Browser-safe Supabase project configuration for Auth and public Storage URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Storage credential and the normalized owner email allowed into Admin.
SUPABASE_SECRET_KEY=
SUPABASE_ADMIN_EMAIL=
